{
  "images": {
    "sizes": [480],
    "minimumCacheTTL": 86400,
    "remotePatterns": [
      { "protocol": "https", "hostname": "ravi-saree-emporium.s3.ap-south-1.amazonaws.com" }
    ]
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ravisareeemporium-iwcl.onrender.com/api/:path*"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|Pinterestbot|SkypeUriPreview|Viber).*"
        }
      ],
      "missing": [{ "type": "query", "key": "app" }],
      "destination": "/api/link-preview?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
